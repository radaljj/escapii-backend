# ================================================================
# ESCAPII BACKEND — Environment varijable
# ================================================================
# KORISCENJE:
#   1. Kopiraj ovaj fajl: cp .env.example .env
#   2. Popuni vrednosti u .env
#   3. NIKAD ne commituj .env na GitHub!
#
# Produkcija: ove vrednosti zive u /opt/escapii/backend/.env na Hetzner serveru.
# Aplikacija se pali kroz systemd (escapii-backend), iza nginx-a i Cloudflare-a.
# ================================================================

# ----- BAZA PODATAKA -----
# Produkcijska baza se zove "escapii" (ne escapii_db)
DB_URL=jdbc:postgresql://localhost:5432/escapii
DB_USERNAME=postgres
DB_PASSWORD=tvoja_lokalna_lozinka
# validate = ne dira shemu, samo proverava da odgovara entitetima (produkcija).
# Lokalno stavi update dok razvijas, inace ti se aplikacija nece upaliti bez migracija.
DDL_AUTO=validate

# ----- EMAIL (Resend, transakcioni provajder) -----
# Presli smo sa Gmail SMTP-a zbog dnevnog limita i lose isporucivosti.
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
# Kod Resend-a je korisnicko ime bukvalno "resend", lozinka je API kljuc
MAIL_USERNAME=resend
MAIL_APP_PASSWORD=re_xxxxxxxxxxxxxxxxxxxx
# FROM adresa — mora biti na verifikovanom domenu kod Resend-a
MAIL_FROM=noreply@escapii.rs

# ----- ADRESE TIMA -----
# Javna kontakt adresa koju kupci vide (Cloudflare Email Routing je prosledjuje na TEAM_EMAIL)
CONTACT_EMAIL=info@escapii.rs
# Interna adresa na koju TIM prima obavestenja — ne mesati sa CONTACT_EMAIL
TEAM_EMAIL=escapii.team@gmail.com
OPS_EMAIL=escapii.team@gmail.com

# ----- DOMENI -----
# CORS whitelist — browser poredi origin DOSLOVNO. Pogresna vrednost ovde
# obara celu formu za rezervaciju, bez ikakve poruke o gresci.
CORS_ALLOWED_ORIGIN=https://escapii.rs
# Extra origins SAMO za lokalni razvoj — u produkciji ostaviti prazno
CORS_EXTRA_ORIGINS=
# Koristi se za magic link u reveal mejlu
FRONTEND_URL=https://escapii.rs
# Koristi se za logo u email templateima
BACKEND_URL=https://api.escapii.rs

# ----- ADMIN -----
# OBAVEZNO promeniti u produkciji — stiti sve /api/admin/** endpointe
ADMIN_KEY=dugacak_nasumican_kljuc
# Apsolutna putanja za upload slika destinacija
UPLOADS_DIR=/opt/escapii/backend/uploads

# ----- SERVER -----
PORT=8080
